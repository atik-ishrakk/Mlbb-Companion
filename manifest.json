{
"manifest_version": 3,
"name": "MLBB Companion Suite",
"version": "2.1.0",
"description": "Real-Time Drafting Assistant, Counter Recommender & BlueStacks 5 Computer Vision Suite for Mobile Legends: Bang Bang.",

"permissions": [
"tabs",
"storage"
],

"host_permissions": [
"http://localhost:5000/*",
"http://127.0.0.1:5000/*",
"http://127.0.0.1:8000/*"
],

"action": {
"default_popup": "src/html/popup.html",
"default_title": "MLBB Companion Hub",
"default_icon": "src/assets/img/logo.png"
},

"icons": {
"16": "src/assets/img/logo.png",
"48": "src/assets/img/logo.png",
"128": "src/assets/img/logo.png"
},

"background": {
"service_worker": "service_worker.js"
}
}
